# IVS Valuation Engine - Environment Variables Example
# Copy this file to .env and update with your actual values

# Application
APP_NAME="IVS Valuation Engine"
DEBUG=False
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/ivs_valuation_db
DATABASE_ECHO=False

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# Market Data APIs (Optional)
YAHOO_FINANCE_ENABLED=True
BLOOMBERG_API_KEY=
BLOOMBERG_ENABLED=False
REFINITIV_API_KEY=
REFINITIV_ENABLED=False
DAMODARAN_ENABLED=True

# Redis (Optional)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# Celery (Optional)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_ENABLED=False

# IVS Defaults
DEFAULT_CURRENCY=MYR
DEFAULT_RISK_FREE_RATE_SOURCE="Malaysia 10Y Government Bond"
DEFAULT_EXPLICIT_FORECAST_YEARS=5
DEFAULT_TERMINAL_GROWTH_RATE=0.02

# Report Generation
REPORT_LANGUAGE="British English"
